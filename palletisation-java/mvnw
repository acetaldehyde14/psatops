#!/bin/sh
# Maven Wrapper Script
# Licensed to the Apache Software Foundation (ASF) under one or more contributor license agreements.

if [ -z "$JAVA_HOME" ] ; then
  JAVA_HOME_GUESS=$(dirname $(dirname $(readlink -f $(which java) 2>/dev/null) 2>/dev/null) 2>/dev/null)
  if [ -d "$JAVA_HOME_GUESS" ]; then
    JAVA_HOME="$JAVA_HOME_GUESS"
  fi
fi

MAVEN_WRAPPER_JAR="$(dirname "$0")/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$(dirname "$0")/.mvn/wrapper/maven-wrapper.properties"

distributionUrl=$(grep distributionUrl "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2)
MAVEN_VERSION=$(echo "$distributionUrl" | grep -oE 'apache-maven-[0-9.]+' | head -1)
MAVEN_DIST_DIR="$HOME/.m2/wrapper/dists/${MAVEN_VERSION}"

if [ ! -d "${MAVEN_DIST_DIR}" ]; then
  mkdir -p "${MAVEN_DIST_DIR}"
  TMPZIP="${MAVEN_DIST_DIR}/apache-maven.zip"
  echo "Downloading Maven from $distributionUrl..."
  curl -sL "$distributionUrl" -o "$TMPZIP"
  unzip -q "$TMPZIP" -d "${MAVEN_DIST_DIR}"
  rm "$TMPZIP"
fi

MAVEN_HOME=$(find "${MAVEN_DIST_DIR}" -maxdepth 1 -name "apache-maven-*" -type d | head -1)
exec "${MAVEN_HOME}/bin/mvn" "$@"
